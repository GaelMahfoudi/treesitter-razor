{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "razor",
      "path": ".",
      "scope": "source.razor",
      "file-types": [
        "razor",
        "cshtml"
      ],
      "injection-regex": "^razor$",
      "highlights": [
        "queries/highlights.scm"
      ],
      "injections": [
        "queries/injections.scm"
      ]
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Razor grammar for tree-sitter",
    "authors": [
      {
        "name": "Gael Mahfoudi"
      }
    ]
  }
}
